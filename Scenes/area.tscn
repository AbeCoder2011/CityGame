[sub_resource type="GDScript" id="GDScript_50glp"]
resource_name = "Area"
script/source = "extends Node2D

var cost := 9.0
var area : Vector2i

func Update():
	$Label.text = \"[font=res://Assets/Fonts/Space_Mono/SpaceMono.ttf]To Unlock:\\n[img]res://Assets/coin.png[/img] \" + Global.GetBigNumber(cost)
	$Button.show()


func _on_button_pressed() -> void:
	if Global.Money >= cost:
		Global.Money -= cost
		$\"../..\".UpdateCityStats()
		$\"../..\".BuildableAreas.append(Rect2((area * Vector2i(6,6)) - Vector2i(3,3),Vector2i(6,6)))
		$\"..\".OpenAreas.append(area)
		$\"..\".total_buys += 1
		$\"..\".DeleteMe(self)
		$\"..\".Recalculate()
		queue_free()
"

