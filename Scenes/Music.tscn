[gd_scene format=3 uid="uid://cedpg40fm8shm"]

[sub_resource type="GDScript" id="GDScript_jw32o"]
script/source = "extends AudioStreamPlayer

var songs: Array[AudioStream] = [
	preload(\"res://Assets/Music/Bleeping Demo.mp3\"),
	preload(\"res://Assets/Music/Pleasant Porridge.mp3\"),
	preload(\"res://Assets/Music/Funky Boxstep.mp3\"),
]

var last_song_index := -1

func _ready() -> void:
	await get_tree().process_frame
	play_random_song()

func play_random_song() -> void:
	var index :int
	randomize()
	index = randi_range(0,len(songs) - 1)
	while last_song_index == index:
		index = randi_range(0,len(songs)-1)
	stream = songs[index]
	play()
	last_song_index = index



func _on_finished() -> void:
	play_random_song()
"

[node name="Music" type="Node" unique_id=1084177566]

[node name="MusicPlayer" type="AudioStreamPlayer" parent="." unique_id=773245750]
process_mode = 3
autoplay = true
bus = &"Music"
script = SubResource("GDScript_jw32o")

[connection signal="finished" from="MusicPlayer" to="MusicPlayer" method="_on_finished"]
