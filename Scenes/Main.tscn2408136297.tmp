[sub_resource type="GDScript" id="GDScript_50glp"]
resource_name = "AreaSpawner"
script/source = "extends Node2D

const STARTER = Vector2i(0,0)

var Area = preload(\"res://Scenes/area.tscn\")

func _ready() -> void:
	GenerateAreas()

func GenerateAreas():
	for x in range(-10,10):
		for y in range(-10,10):
			if Vector2i(x,y) == STARTER:
				continue
			var a : Node2D = Area.instantiate()
			a.position = Vector2(x*288,y*288)
			a.cost = max(abs(x),1) * max(abs(y),1)
			a.area = Vector2i(x,y)
			a.Update()
			add_child(a)
"

