[sub_resource type="GDScript" id="GDScript_o2ick"]
script/source = "@tool
extends TextureRect

@export var PointerName : String = \"\"
@export var active : bool = false


@export var VERTICAL : bool = true

@export var start : Vector2i = Vector2i.ZERO

func _ready() -> void:
	start = position

func register_self():
	pass

func _process(delta: float) -> void:
	hide()
	if active:
		show()
		if VERTICAL:
			offset_transform_rotation = 0
			
			offset_transform_position.y = start.y + (sin(float(Engine.get_frames_drawn()) / 10) * 900) * delta
			offset_transform_position.x = start.x
		else:
			offset_transform_rotation = PI / 2
			offset_transform_position.x = start.x + (sin(float(Engine.get_frames_drawn()) / 10) * 900) * delta
			offset_transform_position.y = start.y
		
"

