[gd_scene format=3 uid="uid://csv7a2aigbi2k"]

[ext_resource type="Texture2D" uid="uid://pm6vjgvxasmm" path="res://Assets/tutorial.png" id="1_e37bj"]

[sub_resource type="GDScript" id="GDScript_o2ick"]
script/source = "@tool
extends Control

@export var PointerName : String = \"\"
@export var active : bool = false


@export var VERTICAL : bool = true

@export var start : Vector2i = Vector2i.ZERO

@onready var p = $Pointer

func _ready() -> void:
	p.offset_transform_enabled = true
	if not Engine.is_editor_hint():
		register_self()

func register_self():
	get_node(\"/root/Main/UI/UI/Tutorial\").register_pointer(self,PointerName)

func _process(delta: float) -> void:
	p.offset_transform_enabled = true
	hide()
	if active:
		show()
		var val = (sin(float(Engine.get_frames_drawn()) / 10) * 60) * delta
		if VERTICAL:
			p.offset_transform_rotation = 0
			p.offset_transform_position.y = start.y + val * 15
			p.offset_transform_scale.y = val * .5 + 1
			p.offset_transform_position.x = start.x
		else:
			p.offset_transform_rotation = -PI / 2
			p.offset_transform_position.x = start.x + val * 15
			p.offset_transform_scale.x = val * .5 + 1
			p.offset_transform_position.y = start.y
		
"

