[sub_resource type="Curve2D" id="Curve2D_ly0hq"]

[sub_resource type="GDScript" id="GDScript_6ebbn"]
resource_name = "plane"
script/source = "extends Path2D

var speed = 100

func setup(target: Vector2, entry: Vector2, start_pos: Vector2) -> void:
	position = start_pos
	curve = Curve2D.new()
	curve.add_point(Vector2.ZERO)
	curve.add_point(entry - start_pos, -(target - entry).normalized() * 500, (target - entry).normalized() * 500)
	curve.add_point(target - start_pos)
	speed = randi_range(70,250)
func _process(delta: float) -> void:
	# Remaining flight pixels
	var rm = curve.get_baked_length() - $Plane.progress
	# Elapsed flight pixels
	var el = $Plane.progress
	
	if el < 100:
		modulate.a = el / 100
	if rm < 600:
		# Slow down for stop
		$Plane.progress += delta * clamp(rm * (float(speed) / 100.0),35,speed * 2) / 2
		$Plane/Shadow.global_position = $Plane.global_position + Vector2(max(rm,0) / 10,max(rm,0) / 30)
	else:
		# FULL SPEED BABYYY
		$Plane.progress += delta * speed
		$Plane/Shadow.global_position = $Plane.global_position + Vector2(60,20)
	
	# Hide plane on arrival
	if $Plane.progress >= curve.get_baked_length():
		$Plane.modulate.a = float($Plane.modulate.a) - delta * 2
		if $Plane.modulate.a <= 0.01:
			queue_free()
			
"

